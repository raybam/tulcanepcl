# Neon PostgreSQL Database URL
DATABASE_URL="postgresql://username:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Application URL (Base URL)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional external backend API URL (leave empty if using internal Next.js API routes)
NEXT_PUBLIC_API_URL=""

# Cloudinary Credentials (Image & PDF Uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
